location = /xymon-ingest {
    limit_except POST {
        deny all;
    }

    auth_basic "Xymon clients";
    auth_basic_user_file /etc/nginx/xymon-client.htpasswd;

    client_max_body_size 1048575;
    proxy_request_buffering on;
    proxy_buffering off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;

    # The trailing slash maps /xymon-ingest to the gateway's root path.
    proxy_pass http://127.0.0.1:1985/;
}

location = /xymon-minicfg {
    limit_except GET {
        deny all;
    }

    auth_basic "Xymon clients";
    auth_basic_user_file /etc/nginx/xymon-client.htpasswd;

    proxy_buffering off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;

    # Always replace any client-supplied value used to select its config.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_pass http://127.0.0.1:1985/minicfg;
}
